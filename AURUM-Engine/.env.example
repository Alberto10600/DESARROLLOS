# AURUM Engine — environment variables
# Copy this to .env and fill in your values

HOST=127.0.0.1
PORT=8765

# IBKR TWS connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497       # 7497 = paper, 7496 = live
IBKR_CLIENT=1

# Hard risk limits (overrides UI settings)
MAX_RISK_PCT=2.0        # max % equity per trade
MAX_DAILY_LOSS=5.0      # halt trading if daily loss > 5%
MAX_OPEN_POSITIONS=3    # max concurrent open positions
